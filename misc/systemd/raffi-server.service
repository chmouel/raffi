[Unit]
Description=Raffi background server
Documentation=https://github.com/chmouel/raffi
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/raffi --server
Restart=on-failure
RestartSec=5
# The server also shows the launcher window, which starts programs, runs
# scripts and writes anywhere the launcher does, so it is not sandboxed.
WorkingDirectory=%h
# Programs launched from the window outlive a server restart.
KillMode=process

[Install]
WantedBy=graphical-session.target

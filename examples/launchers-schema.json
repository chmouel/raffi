{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Map_of_RaffiConfig",
  "type": "object",
  "additionalProperties": {
    "$ref": "#/$defs/RaffiConfig"
  },
  "$defs": {
    "RaffiConfig": {
      "description": "Represents the configuration for each Raffi entry.",
      "type": "object",
      "properties": {
        "alias": {
          "description": "Route this launcher to an internal command: picking it types this text\nfor you, such as `mp linus/linux` (an addon keyword\nfollowed by its query). Cannot be combined with `binary`, `script` or\n`args` (native UI only).",
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "binary": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "disabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "ifenveq": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "ifenvnotset": {
          "type": [
            "string",
            "null"
          ]
        },
        "ifenvset": {
          "type": [
            "string",
            "null"
          ]
        },
        "ifexist": {
          "type": [
            "string",
            "null"
          ]
        },
        "keyword": {
          "description": "Keyword that stands for `alias` while typing: with keyword `linoux`,\ntyping `linoux torvalds` searches `mp linus/linux torvalds`\nwhile the input keeps showing `linoux torvalds`. Requires `alias`; no\nwhitespace.",
          "type": [
            "string",
            "null"
          ]
        },
        "script": {
          "type": [
            "string",
            "null"
          ]
        },
        "show_preview": {
          "description": "Show the right-hand preview pane when this launcher entry is selected (default: false).",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
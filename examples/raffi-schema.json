{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConfigSchema",
  "description": "Public schema representation of the v1 config format, used for JSON Schema generation.",
  "type": "object",
  "properties": {
    "addons": {
      "description": "Addon configurations (script filters, web searches, etc.)",
      "$ref": "#/$defs/AddonsConfig"
    },
    "general": {
      "description": "General settings (UI, theme, font, etc.)",
      "$ref": "#/$defs/GeneralConfig"
    },
    "launchers": {
      "description": "Launcher entries keyed by name",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RaffiConfig"
      }
    },
    "version": {
      "description": "Config format version (currently 1)",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "$defs": {
    "AddonsConfig": {
      "description": "Container for all addon configurations",
      "type": "object",
      "properties": {
        "calculator": {
          "$ref": "#/$defs/CalculatorAddonConfig"
        },
        "clipboard": {
          "$ref": "#/$defs/ClipboardAddonConfig"
        },
        "color": {
          "$ref": "#/$defs/ColorAddonConfig"
        },
        "currency": {
          "$ref": "#/$defs/CurrencyAddonConfig"
        },
        "devtools": {
          "$ref": "#/$defs/DevtoolsAddonConfig"
        },
        "emoji": {
          "$ref": "#/$defs/EmojiAddonConfig"
        },
        "file_browser": {
          "$ref": "#/$defs/FileBrowserAddonConfig"
        },
        "keyword_min_chars": {
          "description": "Characters to type before addon keywords are suggested (default: 3).\nA keyword typed in full is always suggested.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "default": null,
          "minimum": 0
        },
        "script_filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScriptFilterConfig"
          }
        },
        "system": {
          "$ref": "#/$defs/SystemAddonConfig"
        },
        "text_snippets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextSnippetSourceConfig"
          }
        },
        "units": {
          "$ref": "#/$defs/UnitsAddonConfig"
        },
        "web_searches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WebSearchConfig"
          }
        },
        "world_clock": {
          "$ref": "#/$defs/WorldClockAddonConfig"
        }
      },
      "additionalProperties": false
    },
    "CalculatorAddonConfig": {
      "description": "Configuration for the calculator addon",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "ClipboardAction": {
      "description": "What the clipboard addon does with the selected history item",
      "oneOf": [
        {
          "description": "Put the item back on the clipboard with all of its formats",
          "type": "string",
          "const": "copy"
        },
        {
          "description": "Copy the item, then paste it into the window that had focus before\nRaffi opened (Hyprland only)",
          "type": "string",
          "const": "hypr_paste"
        }
      ]
    },
    "ClipboardAddonConfig": {
      "description": "Configuration for the clipboard history addon (native UI only)",
      "type": "object",
      "properties": {
        "action": {
          "description": "Action on Enter (default: `copy`).",
          "$ref": "#/$defs/ClipboardAction"
        },
        "backend": {
          "$ref": "#/$defs/ClipboardBackend"
        },
        "enabled": {
          "description": "Off by default; requires a running clipboard manager.",
          "type": "boolean",
          "default": false
        },
        "image_trigger": {
          "description": "Keyword that opens the history showing only images (default: `clipimg`).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "min_chars": {
          "description": "Hide text entries shorter than this many characters, ignoring\nsurrounding whitespace (default: 3). Images and files are always shown.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "default": null,
          "minimum": 0
        },
        "secondary_action": {
          "description": "Action on Ctrl+Enter (default: `hypr_paste`).",
          "$ref": "#/$defs/ClipboardAction"
        },
        "trigger": {
          "description": "Keyword that opens the history (default: `clip`).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "ClipboardBackend": {
      "description": "Clipboard manager that stores the history browsed by the clipboard addon",
      "oneOf": [
        {
          "description": "CopyQ, through its command line scripting API",
          "type": "string",
          "const": "copyq"
        }
      ]
    },
    "ClipboardHistory": {
      "description": "Clipboard manager used for `{clipboard:N}` snippet placeholders",
      "oneOf": [
        {
          "description": "Use whichever of cliphist, CopyQ or clipman is running",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Read history with `cliphist list` and `cliphist decode`",
          "type": "string",
          "const": "cliphist"
        },
        {
          "description": "Read history with `copyq read`",
          "type": "string",
          "const": "copyq"
        },
        {
          "description": "Read clipman's JSON history file",
          "type": "string",
          "const": "clipman"
        },
        {
          "description": "Disable clipboard history placeholders",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "ColorAddonConfig": {
      "description": "Configuration for the inline color converter addon",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "CurrencyAddonConfig": {
      "description": "Configuration for the currency addon",
      "type": "object",
      "properties": {
        "currencies": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          }
        },
        "default_currency": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "trigger": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "DevtoolsAddonConfig": {
      "description": "Configuration for the developer tools addon: the `dev` transform list\nand the inline `uuid` and `pw` generators (native UI only)",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "password_length": {
          "description": "Length of passwords generated by `pw` without a length, from 8 to 128\n(default: 20).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "default": null,
          "maximum": 128,
          "minimum": 8
        },
        "trigger": {
          "description": "Keyword that opens the transform list (default: `dev`).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "EmojiAddonConfig": {
      "description": "Configuration for the emoji picker addon",
      "type": "object",
      "properties": {
        "action": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "data_files": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "secondary_action": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "trigger": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "FileBrowserAddonConfig": {
      "description": "Configuration for the file browser addon",
      "type": "object",
      "properties": {
        "action": {
          "description": "Action on Enter for files: `open` (xdg-open), `copy`, `insert`, or a\nshell command where `{value}` is the full path. Defaults to `open`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "backspace_updir": {
          "description": "Backspace on a trailing `/` jumps to the parent directory, like\nEmacs fido/ido mode.",
          "type": "boolean",
          "default": true
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "file_manager": {
          "description": "File manager opened with Ctrl+O on the browsed directory. `{value}` is\nreplaced by the directory, otherwise it is appended as the last\nargument. Nautilus, Dolphin, Nemo and Caja also get the selected entry\nhighlighted. Autodetected when unset.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "secondary_action": {
          "description": "Action on Ctrl+Enter for files and directories, with the same values as\n`action`. Defaults to `copy`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "show_hidden": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "sort": {
          "description": "Initial order of the listing; Ctrl+S cycles through the modes.\nDirectories are always listed first.",
          "$ref": "#/$defs/FileBrowserSort"
        },
        "sort_reverse": {
          "description": "Reverse the sort order: Z to A, or oldest first for date sorts.\nDirectories stay first and Ctrl+S keeps this setting.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "FileBrowserSort": {
      "description": "Order of file browser entries",
      "oneOf": [
        {
          "description": "Alphabetical, case-insensitive",
          "type": "string",
          "const": "name"
        },
        {
          "description": "Last modification time, newest first (`date` is accepted as an alias)",
          "type": "string",
          "const": "modified"
        },
        {
          "description": "Creation time, newest first, where the filesystem records it",
          "type": "string",
          "const": "created"
        }
      ]
    },
    "GeneralConfig": {
      "description": "General configuration for persistent defaults",
      "type": "object",
      "properties": {
        "clipboard_history": {
          "description": "Clipboard manager for `{clipboard:N}` snippet placeholders",
          "$ref": "#/$defs/ClipboardHistory"
        },
        "default_script_shell": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "fallbacks": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "font_family": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "font_size": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "max_history": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "no_icons": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "padding": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "preview": {
          "description": "Appearance of the right-hand preview pane (font, size, colours, width)",
          "$ref": "#/$defs/PreviewConfig"
        },
        "show_preview": {
          "description": "Show the Alfred-style right-hand preview pane in native mode.\nBy default, previews are shown automatically for addons (snippets, file browser,\nscript filters, etc.) and hidden for standard launcher entries unless `show_preview: true`\nis set in `general` or on the launcher entry. Can also be toggled at runtime with Ctrl+P.",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "sort_mode": {
          "$ref": "#/$defs/SortMode"
        },
        "terminal_classes": {
          "description": "Extra window classes treated as terminals by `hypr_paste` (sent Ctrl+Shift+V\ninstead of Ctrl+V). Added to the built-in list; matched case-insensitively.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "theme": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "theme_colors": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThemeColorsConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "ui_type": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "window_height": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "window_width": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "PreviewColorsConfig": {
      "description": "Colour overrides for the right-hand preview pane (hex: #RGB, #RRGGBB, or #RRGGBBAA).",
      "type": "object",
      "properties": {
        "accent": {
          "description": "Headings, badges and hero values",
          "type": [
            "string",
            "null"
          ]
        },
        "bg": {
          "description": "Background of the whole preview pane",
          "type": [
            "string",
            "null"
          ]
        },
        "bg_block": {
          "description": "Background of the content/code blocks inside the pane",
          "type": [
            "string",
            "null"
          ]
        },
        "border": {
          "description": "Pane and block borders",
          "type": [
            "string",
            "null"
          ]
        },
        "text_main": {
          "description": "Title and main text colour",
          "type": [
            "string",
            "null"
          ]
        },
        "text_muted": {
          "description": "Subtitles, metadata keys and hints",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "PreviewConfig": {
      "description": "Appearance settings for the right-hand preview pane in native mode.",
      "type": "object",
      "properties": {
        "colors": {
          "description": "Colour overrides for the preview pane",
          "anyOf": [
            {
              "$ref": "#/$defs/PreviewColorsConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "font_family": {
          "description": "Font family for the preview pane (default: the UI font)",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "font_size": {
          "description": "Base font size in px for preview text (default: 16). Title, headings and\nhero values scale from it.",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "mono_font_family": {
          "description": "Monospace font family for code/text blocks (default: system monospace)",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "width_percent": {
          "description": "Width of the preview pane as a percentage of the window (10-80, default: 50)",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "RaffiConfig": {
      "description": "Represents the configuration for each Raffi entry.",
      "type": "object",
      "properties": {
        "args": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "binary": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "disabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "ifenveq": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "ifenvnotset": {
          "type": [
            "string",
            "null"
          ]
        },
        "ifenvset": {
          "type": [
            "string",
            "null"
          ]
        },
        "ifexist": {
          "type": [
            "string",
            "null"
          ]
        },
        "script": {
          "type": [
            "string",
            "null"
          ]
        },
        "show_preview": {
          "description": "Show the right-hand preview pane when this launcher entry is selected (default: false).",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ScriptFilterConfig": {
      "description": "Configuration for a script filter addon",
      "type": "object",
      "properties": {
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "command": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "keyword": {
          "type": "string"
        },
        "min_query_length": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "secondary_action": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "command",
        "keyword"
      ]
    },
    "SortMode": {
      "description": "Sort mode for launcher entries and text snippets by past use",
      "oneOf": [
        {
          "description": "Sort by launch count (most frequently used first)",
          "type": "string",
          "const": "frequency"
        },
        {
          "description": "Sort by last-used time (most recently used first)",
          "type": "string",
          "const": "recency"
        },
        {
          "description": "Combined score: 40% frequency + 60% recency",
          "type": "string",
          "const": "hybrid"
        }
      ]
    },
    "SystemAddonConfig": {
      "description": "Configuration for the system commands addon (native UI only)",
      "type": "object",
      "properties": {
        "commands": {
          "$ref": "#/$defs/SystemCommandsConfig"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "hide": {
          "description": "Entries left out of the list.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SystemCommand"
          }
        },
        "trigger": {
          "description": "Keyword that opens the list (default: `sys`).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "SystemCommand": {
      "description": "A built-in entry of the system commands addon",
      "type": "string",
      "enum": [
        "lock",
        "suspend",
        "hibernate",
        "logout",
        "reboot",
        "shutdown"
      ]
    },
    "SystemCommandsConfig": {
      "description": "Commands replacing the built-in ones of the system commands addon, as\nargument lists run without a shell. An empty list hides the entry.",
      "type": "object",
      "properties": {
        "hibernate": {
          "description": "Default: `systemctl hibernate`.",
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          }
        },
        "lock": {
          "description": "Default: `loginctl lock-session`.",
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          }
        },
        "logout": {
          "description": "Default: `hyprctl dispatch exit` on Hyprland, otherwise\n`loginctl terminate-session $XDG_SESSION_ID`.",
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          }
        },
        "reboot": {
          "description": "Default: `systemctl reboot`.",
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          }
        },
        "shutdown": {
          "description": "Default: `systemctl poweroff`.",
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          }
        },
        "suspend": {
          "description": "Default: `systemctl suspend`.",
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "TextSnippet": {
      "description": "A single text snippet entry",
      "type": "object",
      "properties": {
        "icon": {
          "description": "Emoji, icon name, or image path overriding the source icon.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "keyword": {
          "description": "Optional short keyword; an exact match ranks the snippet first.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ]
    },
    "TextSnippetSourceConfig": {
      "description": "Configuration for a text snippet source",
      "type": "object",
      "properties": {
        "action": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "command": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "directory": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "file": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "icon": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "keyword": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "placeholders": {
          "description": "Expand dynamic placeholders such as {clipboard} and {date} in snippet values.",
          "type": "boolean",
          "default": true
        },
        "restore_clipboard": {
          "description": "Best-effort restoration of plain text after the `hypr_paste` action.",
          "type": "boolean",
          "default": false
        },
        "secondary_action": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "snippets": {
          "type": [
            "array",
